                            android:layout_height="wrap_content"
                            android:text="@string/git_action_push"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
