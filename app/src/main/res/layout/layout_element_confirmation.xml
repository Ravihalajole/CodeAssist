<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/ovl_spacing_lg">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/ovl_corner_lg"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/ovl_raised"
        app:strokeColor="@color/ovl_stroke"
        app:strokeWidth="@dimen/ovl_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ovl_spacing_xl">

            <TextView
                android:id="@+id/tvRoleTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confirm Target"
                android:textSize="@dimen/ovl_text_lg"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/ovl_spacing_lg"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/ovl_card"
                app:cardCornerRadius="@dimen/ovl_corner_md"
                app:cardElevation="0dp"
                android:layout_marginBottom="@dimen/ovl_spacing_lg">

                <TextView
                    android:id="@+id/tvElementDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:padding="@dimen/ovl_spacing_lg"
                    android:textSize="@dimen/ovl_text_md"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingExtra="4dp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvChildrenLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Navigate Hierarchy"
                android:textSize="@dimen/ovl_text_xs"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_mid"
                android:textAllCaps="true"
                android:layout_marginBottom="@dimen/ovl_spacing_md"
                android:visibility="gone"/>

            <HorizontalScrollView
                android:id="@+id/hsvChildren"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="@dimen/ovl_spacing_xl"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/llChildrenList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetry"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:icon="@android:drawable/ic_menu_revert"
                    app:iconTint="@color/state_red" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectParent"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/ovl_spacing_sm"
                    android:text="Parent"
                    app:strokeColor="@color/ovl_handle" />

                <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveNext"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Save &amp; Next"
                    app:backgroundTint="@color/brand_mint"
                    android:textColor="@color/brand_on_accent"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
