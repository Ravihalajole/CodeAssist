<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="16dp"
    android:paddingBottom="12dp">

    <!-- Expandable Tool Drawer -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/llToolDrawer"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#F214141A"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:strokeColor="#2200E5FF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

        <!-- Tool Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="2dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Agent Tools"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolClose"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_close"
                app:iconTint="#90A4AE"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:backgroundTint="@android:color/transparent"
                android:contentDescription="Close tools" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins">

            <!-- Init Tool -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolInit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Init"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:paddingHorizontal="4dp"
                app:icon="@drawable/ic_play"
                app:iconTint="#00E676"
                app:iconGravity="top"
                app:iconSize="24dp"
                app:iconPadding="4dp"
                app:strokeColor="#3300E676"
                app:cornerRadius="16dp" />

            <!-- Bounds Picker -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolBounds"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Bounds"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:paddingHorizontal="4dp"
                app:icon="@drawable/ic_target_crosshair"
                app:iconTint="#AB47BC"
                app:iconGravity="top"
                app:iconSize="24dp"
                app:iconPadding="4dp"
                app:strokeColor="#33AB47BC"
                app:cornerRadius="16dp" />

            <!-- New Session -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolNewSession"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Reset"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:paddingHorizontal="4dp"
                app:icon="@android:drawable/ic_menu_rotate"
                app:iconTint="#FFA726"
                app:iconGravity="top"
                app:iconSize="24dp"
                app:iconPadding="4dp"
                app:strokeColor="#33FFA726"
                app:cornerRadius="16dp" />

            <!-- Settings (Main App) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="App"
                android:textColor="#E0E0E0"
                android:textSize="12sp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:paddingHorizontal="4dp"
                app:icon="@drawable/ic_nav_settings"
                app:iconTint="#78909C"
                app:iconGravity="top"
                app:iconSize="24dp"
                app:iconPadding="4dp"
                app:strokeColor="#3378909C"
                app:cornerRadius="16dp" />

            <!-- Exit Mode -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolStopSession"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Exit"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:paddingHorizontal="4dp"
                app:icon="@drawable/ic_close"
                app:iconTint="#FF5252"
                app:iconGravity="top"
                app:iconSize="24dp"
                app:iconPadding="4dp"
                app:strokeColor="#44FF5252"
                app:cornerRadius="16dp" />
        </GridLayout>

        <!-- Nested Close Session Safety Confirmation -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/llCloseConfirmBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#22FF1744"
            app:cardCornerRadius="12dp"
            app:strokeColor="#55FF1744"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Terminate agent mode?"
                    android:textColor="#FF8A80"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCloseConfirm"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Exit"
                    android:textSize="11sp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:backgroundTint="#FF1744"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Outer Gradient Border Container -->
    <FrameLayout
        android:id="@+id/flPillGradientBorder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="2dp"
        android:background="@drawable/bg_dynamic_pill_gradient">

        <!-- Inner Dark Floating Pill Card -->
        <LinearLayout
            android:id="@+id/llPillContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_dynamic_pill_gradient"
            android:backgroundTint="#F2121216"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:paddingVertical="5dp">

            <!-- Status Dot -->
            <View
                android:id="@+id/vAgentStatusIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bubble_bg"
                android:backgroundTint="#00E5FF" />

            <!-- Status Column (headline + detail) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp">

                <!-- Status Label -->
                <TextView
                    android:id="@+id/tvShieldStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Idle"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:maxLines="1" />

                <!-- Status Detail (optional secondary line) -->
                <TextView
                    android:id="@+id/tvShieldDetail"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textColor="#9E9E9E"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Tool Palette Toggle Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToolbox"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_nav_settings"
                app:iconTint="#B0BEC5"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:backgroundTint="@android:color/transparent"
                android:layout_marginEnd="6dp"
                android:contentDescription="Toggle tools" />

            <!-- Morphing Primary Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMorphingAction"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_stroke_play"
                app:iconSize="18dp"
                app:iconTint="#121212"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:backgroundTint="#FFFFFF"
                android:contentDescription="Play or stop" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>