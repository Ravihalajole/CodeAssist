<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="4dp"
    android:paddingBottom="10dp">

    <!-- Transient status chip (shown for explicit messages only) -->
    <LinearLayout
        android:id="@+id/llStatusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_status_chip"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="220dp"
            android:text=""
            android:textColor="?attr/colorOnSurface"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Command Orb (drag · tap to play/stop · hold for the radial ring) -->
    <FrameLayout
        android:id="@+id/flOrbContainer"
        android:layout_width="80dp"
        android:layout_height="80dp">

        <org.ravi.codeassist.ui.CommandOrbView
            android:id="@+id/orbView"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="Agent control orb" />
    </FrameLayout>
</LinearLayout>
