<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/confirmationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ovl_scrim"
    android:padding="@dimen/ovl_spacing_xl">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/ovl_raised"
        app:cardCornerRadius="@dimen/ovl_corner_lg"
        app:cardElevation="8dp"
        app:strokeColor="@color/ovl_stroke"
        app:strokeWidth="@dimen/ovl_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ovl_spacing_xl">

            <TextView
                android:id="@+id/tvOverlayTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Action Required"
                android:textSize="@dimen/ovl_text_lg"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ovl_spacing_xs"
                android:text="The agent proposed a code modification batch."
                android:textSize="@dimen/ovl_text_xs"
                android:fontFamily="sans-serif"
                android:textColor="@color/text_mid" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ovl_spacing_lg"
                android:layout_marginBottom="@dimen/ovl_spacing_lg"
                app:cardBackgroundColor="@color/ovl_card"
                app:cardCornerRadius="@dimen/ovl_corner_md"
                app:strokeColor="@color/ovl_stroke"
                app:strokeWidth="@dimen/ovl_stroke">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/confirm_scroll_h"
                    android:fadeScrollbars="false"
                    android:padding="@dimen/ovl_spacing_md">

                    <TextView
                        android:id="@+id/tvOverlaySummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="@dimen/ovl_text_md"
                        android:textColor="?attr/colorOnSurface" />
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/overlayProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ovl_spacing_lg"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/brand_mint"
                app:trackCornerRadius="@dimen/ovl_spacing_xs"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayReject"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discard"
                    android:textColor="@color/state_red" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOverlayApprove"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ovl_spacing_sm"
                    android:text="Apply Patch"
                    app:backgroundTint="@color/brand_mint"
                    app:iconTint="@color/brand_on_accent"
                    android:textColor="@color/brand_on_accent"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
