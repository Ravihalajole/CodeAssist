package org.ravi.codeassist

import java.io.File
import java.util.regex.Pattern

object CommandExecutor {

    data class ExecutionResult(
        val success: Boolean,
        val logMsg: String,
        val outputToClipboard: String? = null,
        val backupPath: String? = null
    )

    fun validate(command: CodeCommand, workspaceRoot: String): String? {
        val rootDir = File(workspaceRoot)
        if (!rootDir.exists() || !rootDir.isDirectory) return "Workspace root invalid."

        return try {
            when (command) {
                is CodeCommand.PatchFile -> {
                    val targetFile = File(rootDir, command.path)
                    if (!targetFile.exists() || !targetFile.isFile) {
                        "Patch failed: File does not exist -> ${command.path}"
                    } else {
                        val originalText = targetFile.readText()
                        val normalizedOriginal = originalText.replace("\r\n", "\n")
                        val normalizedSearch = command.search.replace("\r\n", "\n")
                        if (!normalizedOriginal.contains(normalizedSearch)) {
                            "Patch block rejection: Exact matching block not found in ${command.path}"
                        } else null
                    }
                }
                is CodeCommand.ReadFile -> {
                    val targetFile = File(rootDir, command.path)
                    if (!targetFile.exists() || !targetFile.isFile) "File not found: ${command.path}" else null
                }
                is CodeCommand.GrepFile -> {
                    val targetFile = File(rootDir, command.path)
                    if (!targetFile.exists() || !targetFile.isFile) "File not found: ${command.path}" else null
                }
                is CodeCommand.ListDir -> {
                    val targetDir = File(rootDir, command.path)
                    if (!targetDir.exists() || !targetDir.isDirectory) "Directory not found: ${command.path}" else null
                }
                else -> null
            }
        } catch (e: Exception) {
            "Validation Error: ${e.message}"
        }
    }

    fun execute(command: CodeCommand, workspaceRoot: String): ExecutionResult {
        val rootDir = File(workspaceRoot)
        
        // NEW FIX: Auto-create the workspace root if it is missing
        if (!rootDir.exists()) {
            val created = rootDir.mkdirs()
            if (!created) {
                return ExecutionResult(false, "Critical: Could not create Workspace root at $workspaceRoot. Check 'All Files Access' permission in Android Settings.")
            }
        }

        if (!rootDir.isDirectory) {
            return ExecutionResult(false, "Workspace root exists but is not a directory.")
        }

        return try {
            when (command) {
                is CodeCommand.ReadFile -> handleReadFile(rootDir, command.path)
                is CodeCommand.GrepFile -> handleGrepFile(rootDir, command.path, command.pattern)
                is CodeCommand.ListDir -> handleListDir(rootDir, command.path)
                is CodeCommand.CreateFile -> handleCreateFile(rootDir, command.path, command.content)
                is CodeCommand.PatchFile -> handlePatchFile(rootDir, command.path, command.search, command.replace)
                is CodeCommand.DeleteFile -> handleDeleteFile(rootDir, command.path)
            }
        } catch (e: Exception) {
            ExecutionResult(false, "System Error: ${e.localizedMessage}")
        }
    }

    private fun handleReadFile(rootDir: File, relativePath: String): ExecutionResult {
        val targetFile = File(rootDir, relativePath)
        if (!isPathSafe(rootDir, targetFile)) return ExecutionResult(false, "Security Error: Path traversal attempt blocked.")
        return if (targetFile.exists() && targetFile.isFile) {
            val content = targetFile.readText()
            ExecutionResult(true, "Successfully read file: $relativePath", content)
        } else {
            ExecutionResult(false, "File not found: $relativePath")
        }
    }

    private fun handleGrepFile(rootDir: File, relativePath: String, patternStr: String): ExecutionResult {
        val targetFile = File(rootDir, relativePath)
        if (!targetFile.exists() || !targetFile.isFile) {
            return ExecutionResult(false, "File not found for Grep: $relativePath")
        }

        val pattern = try {
            Pattern.compile(patternStr, Pattern.CASE_INSENSITIVE)
        } catch (e: Exception) {
            Pattern.compile(Pattern.quote(patternStr), Pattern.CASE_INSENSITIVE)
        }
        val matchedLines = StringBuilder()
        
        targetFile.useLines { lines ->
            lines.forEachIndexed { index, line ->
                if (pattern.matcher(line).find()) {
                    matchedLines.append("Line ${index + 1}: $line\n")
                }
            }
        }

        val resultText = if (matchedLines.isNotEmpty()) matchedLines.toString() else "No matches found for pattern: $patternStr"
        return ExecutionResult(true, "Grep complete for $relativePath", resultText)
    }

    private fun handleListDir(rootDir: File, relativePath: String): ExecutionResult {
        val targetDir = File(rootDir, relativePath)
        if (!targetDir.exists() || !targetDir.isDirectory) {
            return ExecutionResult(false, "Directory not found: $relativePath")
        }

        val tree = StringBuilder()
        tree.append("[Directory Tree for $relativePath]\n")
        
        targetDir.walkTopDown().maxDepth(3).forEach { file ->
            val relToTarget = file.relativeTo(targetDir).path
            if (relToTarget.isNotEmpty()) {
                val depth = relToTarget.count { it == '/' }
                val indent = "  ".repeat(depth)
                val prefix = if (file.isDirectory) "📁 " else "📄 "
                tree.append("$indent$prefix${file.name}\n")
            }
        }
        return ExecutionResult(true, "Directory listed.", tree.toString())
    }

    private fun handleCreateFile(rootDir: File, relativePath: String, content: String): ExecutionResult {
        val targetFile = File(rootDir, relativePath)
        targetFile.parentFile?.mkdirs()
        targetFile.writeText(content)
        return ExecutionResult(true, "Successfully created file: $relativePath")
    }

    private fun isPathSafe(rootDir: File, targetFile: File): Boolean {
        return targetFile.canonicalPath.startsWith(rootDir.canonicalPath)
    }

    private fun handlePatchFile(rootDir: File, relativePath: String, search: String, replace: String): ExecutionResult {
        val targetFile = File(rootDir, relativePath)
        if (!isPathSafe(rootDir, targetFile)) return ExecutionResult(false, "Security Error: Path traversal attempt blocked.")
        if (!targetFile.exists() || !targetFile.isFile) {
            return ExecutionResult(false, "Patch failed. Target file does not exist: $relativePath")
        }

        val originalText = targetFile.readText()
        val isWindowsLineEndings = originalText.contains("\r\n")
        
        // Match optimization: Normalizing line endings for consistent evaluation
        val normalizedOriginal = originalText.replace("\r\n", "\n")
        val normalizedSearch = search.replace("\r\n", "\n")
        val normalizedReplace = replace.replace("\r\n", "\n")

        val occurrences = normalizedOriginal.split(normalizedSearch).size - 1
        if (occurrences != 1) {
            return ExecutionResult(false, "Patch rejected: Search block appears $occurrences times. Must be uniquely identifiable.")
        }

        // Safety Net: Unique backup file in dedicated .codeassist folder
        val backupDir = File(rootDir, ".codeassist/backups")
        if (!backupDir.exists()) backupDir.mkdirs()
        val backupName = "${targetFile.name}.bak_${System.currentTimeMillis()}"
        val backupFile = File(backupDir, backupName)
        targetFile.copyTo(backupFile, overwrite = true)

        var updatedText = normalizedOriginal.replaceFirst(normalizedSearch, normalizedReplace)
        if (isWindowsLineEndings) {
            updatedText = updatedText.replace("\n", "\r\n")
        }
        targetFile.writeText(updatedText)
        
        return ExecutionResult(true, "Successfully applied file patch modifications to: $relativePath", backupPath = backupFile.name)
    }

    private fun handleDeleteFile(rootDir: File, relativePath: String): ExecutionResult {
        val targetFile = File(rootDir, relativePath)
        return if (targetFile.exists()) {
            if (targetFile.isFile) {
                val backupDir = File(rootDir, ".codeassist/backups")
                if (!backupDir.exists()) backupDir.mkdirs()
                val backupName = "${targetFile.name}.bak_${System.currentTimeMillis()}"
                val backupFile = File(backupDir, backupName)
                targetFile.copyTo(backupFile, overwrite = true)
                targetFile.delete()
                ExecutionResult(true, "Deleted file: $relativePath (Backup created)", backupPath = backupFile.name)
            } else {
                ExecutionResult(false, "Target is a directory, not a file. Operation rejected for data safety.")
            }
        } else {
            ExecutionResult(true, "File already absent: $relativePath")
        }
    }
}
